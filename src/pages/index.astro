    padding: 16px; display: flex; flex-direction: column; gap: 12px; height: var(--widget-height, 180px); transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease; position: relative;
    box-sizing: border-box; backdrop-filter: blur(10px); touch-action: pan-y; overflow: hidden;
