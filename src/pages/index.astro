---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Mora - 个人导航">
  <!-- 左侧收放边栏 -->
  <Sidebar />

  <!-- 主内容区域 -->
  <main class="main-content" id="mainContent">
    <div class="content-wrapper">
      
      <!-- 顶部头部信息 -->
      <header class="greeting-header">
        <h1 class="greeting-title" id="greetingTitle">你好，极客</h1>
        <p class="greeting-subtitle" id="greetingSubtitle">用专注和热爱，度过美好的一天。</p>
      </header>

      <!-- 搜索栏区 -->
      <section class="search-section">
        <SearchBar />
      </section>

      <!-- 导航卡片展示区 -->
      <section class="grid-section" id="gridSection">
        <!-- 客户端动态渲染 -->
      </section>

      <!-- 空状态 -->
      <div class="empty-state" id="emptyState" style="display: none;">
        <i data-lucide="info" class="empty-icon"></i>
        <p>未找到匹配的导航卡片</p>
      </div>

    </div>
  </main>
</Layout>

<style is:global>
  /* 主内容区偏移 */
  .main-content {
    min-height: 100vh;
    padding: 80px 40px 80px 40px;
    margin-left: 0;
    transition: var(--transition-smooth);
    display: flex;
    justify-content: center;
  }

  /* 当左侧侧边栏展开时，右侧主内容平滑右偏 */
  aside.sidebar-container.open ~ .main-content {
    margin-left: 250px;
  }

  .content-wrapper {
    width: 100%;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* 顶部问候 */
  .greeting-header {
    text-align: center;
    margin-top: 10px;
  }

  .greeting-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: 0.5px;
    margin-bottom: 10px;
  }

  .greeting-subtitle {
    font-size: 13px;
    color: var(--color-text-sub);
    letter-spacing: 0.5px;
    opacity: 0.85;
  }

  /* 搜索区 */
  .search-section {
    width: 100%;
    margin-bottom: 10px;
  }

  /* 导航区 */
  .grid-section {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* 分类区块 */
  .category-block {
    display: flex;
    flex-direction: column;
    gap: 18px;
    scroll-margin-top: 100px;
  }

  .category-title-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 8px;
    border-bottom: 1px dashed rgba(0, 0, 0, 0.06);
    user-select: none;
  }

  .category-icon {
    width: 15px;
    height: 15px;
    color: var(--cat-color);
  }

  .category-name {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-text-main);
    letter-spacing: 0.5px;
  }

  .category-badge {
    font-size: 10.5px;
    background: rgba(0, 0, 0, 0.04);
    color: var(--color-text-sub);
    padding: 2px 7px;
    border-radius: 6px;
    font-weight: 550;
  }

  /* 导航网格 */
  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }

  /* ================= 极现代导航卡片样式 ================= */
  a.link-card {
    text-decoration: none !important;
    color: inherit !important;
    display: block;
    position: relative;
    border-radius: var(--radius-md);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    box-shadow: var(--card-shadow);
    transition: var(--transition-smooth);
    overflow: hidden;
    height: 100%;
    cursor: pointer;
    backdrop-filter: blur(10px);
    text-align: left; /* 必须居左对齐 */
    
    /* 引入 GPU 硬件加速及稳定机制 */
    transform: translate3d(0, 0, 0);
    will-change: transform, box-shadow, border-color, background-color;
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  a.link-card:hover {
    transform: translate3d(0, -4px, 0); /* 放弃 scale，采用稳定的 translate3d 平移 */
    border-color: var(--theme-color);
    box-shadow: var(--card-shadow-hover);
  }

  .card-inner {
    position: relative;
    padding: 16px 18px;
    height: 100%;
    display: flex;
    flex-direction: column;
    z-index: 2;
    animation: slideUp 0.6s cubic-bezier(0.25, 1, 0.5, 1) both;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .header-main-info {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-grow: 1;
    overflow: hidden;
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--theme-color);
    transition: var(--transition-smooth);
    flex-shrink: 0;
    
    /* 硬件加速稳定 */
    transform: translate3d(0, 0, 0);
    will-change: transform;
    backface-visibility: hidden;
  }

  a.link-card:hover .icon-wrapper {
    transform: translate3d(0, 0, 0) rotateZ(6deg);
  }

  .card-icon {
    width: 24px;
    height: 24px;
  }

  /* 莫兰迪色标小圆点 */
  .theme-tag {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--theme-color);
    box-shadow: 0 0 6px var(--theme-color);
    transition: var(--transition-smooth);
    
    /* 硬件加速稳定 */
    transform: translate3d(0, 0, 0);
    will-change: transform;
    backface-visibility: hidden;
  }

  a.link-card:hover .theme-tag {
    transform: translate3d(0, 0, 0) scale(1.25);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    font-size: 15.5px;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 0;
    transition: var(--transition-smooth);
    letter-spacing: 0.2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  a.link-card:hover .card-title {
    color: var(--theme-color);
  }

  .card-desc {
    font-size: 13px;
    color: var(--color-text-sub);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ================= 空状态及过渡 ================= */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 80px 0;
    color: var(--color-text-sub);
    font-size: 14px;
    animation: fadeIn 0.4s ease;
  }

  .empty-icon {
    width: 32px;
    height: 32px;
    opacity: 0.6;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translate3d(0, 8px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  /* 响应式调整 */
  @media (max-width: 768px) {
    .main-content {
      padding: 80px 20px 40px 20px;
    }
    
    aside.sidebar-container.open ~ .main-content {
      margin-left: 0;
    }

    .greeting-title {
      font-size: 22px;
    }
  }
</style>

<script src="../scripts/pages/index-page.ts"></script>

