---
import Layout from '../layouts/Layout.astro';
import '../styles/admin.css';
import AdminAuthPanel from '../components/admin/AdminAuthPanel.astro';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import AdminDashboardView from '../components/admin/AdminDashboardView.astro';
import AdminUsersView from '../components/admin/AdminUsersView.astro';
import AdminAppearanceView from '../components/admin/AdminAppearanceView.astro';
import AdminBackupView from '../components/admin/AdminBackupView.astro';
import AdminContentView from '../components/admin/AdminContentView.astro';
import AdminContentModals from '../components/admin/AdminContentModals.astro';
import AdminOverlays from '../components/admin/AdminOverlays.astro';
import AppearanceSettings from '../components/admin/AppearanceSettings.astro';
import BackupSettings from '../components/admin/BackupSettings.astro';
---

<Layout title="Mora 管理控制台">
  <AdminAuthPanel />

  <div class="admin-layout">
    <AdminSidebar />

    <main class="admin-main">
      <header class="mobile-header">
        <div class="mobile-header-left">
          <button type="button" id="mobileMenuBtn" class="action-btn secondary" style="margin:0; padding: 8px;">
            <i data-lucide="menu"></i>
          </button>
          <span class="mobile-title">Mora 控制台</span>
        </div>
      </header>

      <div class="admin-content-wrapper">
        <AdminDashboardView />
        <AdminUsersView />
        <AdminAppearanceView>
          <AppearanceSettings />
        </AdminAppearanceView>
        <AdminBackupView>
          <BackupSettings />
        </AdminBackupView>
        <AdminContentView />
      </div>

      <AdminContentModals />
    </main>
  </div>

  <AdminOverlays />
</Layout>

<script src="../scripts/pages/admin-page.ts"></script>
