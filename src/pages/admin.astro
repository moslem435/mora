        `<option value="${cat.id}">${cat.name}</option>`
      ).join('');

      if (linkCatId) linkCatId.innerHTML = optionsHtml;
      if (editLinkCatId) editLinkCatId.innerHTML = optionsHtml;
    }

    // 渲染分类
