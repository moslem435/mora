<div id="view-users" class="admin-view" hidden aria-hidden="true">
  <div class="view-header view-header-with-action">
    <div>
      <h2>成员管理</h2>
      <p>管理注册用户的角色身份与文件上传权限。</p>
    </div>

    <div class="switch-group site-toggle registration-toggle">
      <div class="switch-label">
        <label for="allowRegistration">允许新管理员注册</label>
        <span class="switch-desc">关闭后将隐藏注册入口</span>
      </div>
      <label class="switch-toggle" aria-label="允许新管理员注册">
        <input type="checkbox" id="allowRegistration" />
        <span class="switch-slider"></span>
      </label>
    </div>
  </div>

  <div class="admin-section users-section">
    <div class="users-table-wrapper">
      <table class="users-table">
        <thead>
          <tr>
            <th>会员邮箱</th>
            <th>加入时间</th>
            <th>角色权限</th>
            <th>上传权限</th>
          </tr>
        </thead>
        <tbody id="usersListBody">
          <tr class="users-state-row"><td colspan="4" class="table-state-cell">载入成员列表中...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
