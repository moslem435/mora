<div id="view-dashboard" class="admin-view active">
  <div class="view-header">
    <h2>概览看板</h2>
    <p>欢迎回到 Mora 管理控制台，这里是您的站点运行数据。</p>
  </div>

  <div class="dashboard-stats-grid">
    <div class="stat-card">
      <div class="stat-icon-wrapper stat-icon-blue">
        <i data-lucide="users"></i>
      </div>
      <div class="stat-info">
        <span class="stat-label">总注册用户</span>
        <span class="stat-value" id="statUsers">...</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon-wrapper stat-icon-purple">
        <i data-lucide="folder"></i>
      </div>
      <div class="stat-info">
        <span class="stat-label">分类总数</span>
        <span class="stat-value" id="statCategories">...</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon-wrapper stat-icon-green">
        <i data-lucide="link"></i>
      </div>
      <div class="stat-info">
        <span class="stat-label">收录链接总数</span>
        <span class="stat-value" id="statLinks">...</span>
      </div>
    </div>
  </div>

  <div class="dashboard-actions-grid">
    <h3>快捷操作</h3>
    <div class="dashboard-actions-row">
      <button type="button" class="action-btn primary" data-admin-quick-target="content" data-admin-focus-target="catName">
        <i data-lucide="plus"></i>
        <span>新建分类</span>
      </button>
      <button type="button" class="action-btn secondary" data-admin-quick-target="content" data-admin-click-target="openAddLinkBtn">
        <i data-lucide="link"></i>
        <span>添加新书签</span>
      </button>
    </div>
  </div>
</div>
