---
interface Props {
  id: string;
  title: string;
  url: string;
  description: string;
  icon?: string;
  color?: string; // morandi color key e.g. 'blue', 'green', 'purple', 'pink', 'orange', 'yellow'
}

const { id, title, url, description, icon = "external-link", color = "blue" } = Astro.props;
---

<a 
  href={url} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="link-card" 
  data-id={id}
  style={`--theme-color: var(--theme-${color});`}
>
  <div class="card-inner">
    <div class="card-header">
      <div class="icon-wrapper">
        <i data-lucide={icon} class="card-icon"></i>
      </div>
      <div class="theme-tag"></div>
    </div>
    <div class="card-content">
      <h3 class="card-title">{title}</h3>
      <p class="card-desc" title={description}>{description}</p>
    </div>
  </div>
</a>

<style is:global>
  .link-card {
    display: block;
    position: relative;
    border-radius: var(--radius-md);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    box-shadow: var(--card-shadow);
    transition: var(--transition-smooth);
    overflow: hidden;
    height: 100%;
    cursor: pointer;
  }

  .card-inner {
    position: relative;
    padding: 16px 18px;
    height: 100%;
    display: flex;
    flex-direction: column;
    z-index: 2;
  }

  /* 悬浮动效 */
  .link-card:hover {
    transform: translateY(-4px) scale(1.015);
    border-color: var(--card-border-hover);
    box-shadow: var(--card-shadow-hover);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.02);
    color: var(--theme-color);
    transition: var(--transition-smooth);
  }

  .link-card:hover .icon-wrapper {
    background: var(--theme-color);
    color: #fff;
    transform: rotate(6deg);
  }

  .card-icon {
    width: 17px;
    height: 17px;
  }

  /* 莫兰迪色标小圆点 */
  .theme-tag {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--theme-color);
    box-shadow: 0 0 6px var(--theme-color);
    transition: var(--transition-smooth);
  }

  .link-card:hover .theme-tag {
    transform: scale(1.25);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--color-text-main);
    margin-bottom: 6px;
    transition: var(--transition-smooth);
  }

  .link-card:hover .card-title {
    color: var(--theme-color);
  }

  .card-desc {
    font-size: 12px;
    color: var(--color-text-sub);
    line-height: 1.5;
    /* 限制显示两行 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
