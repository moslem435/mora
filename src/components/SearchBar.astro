---
// SearchBar.astro
---

<div class="search-container">
  <div class="search-wrapper">
    <!-- 搜索引擎选择器 -->
    <div class="engine-selector">
      <button class="current-engine-btn" id="engineBtn" type="button">
        <span class="current-engine-icon-wrapper" id="currentEngineIconWrapper">
          <img src="https://a.favicon.im/google.com" class="engine-icon-img" alt="" />
        </span>
        <span class="engine-name" id="currentEngineName">Google</span>
        <i data-lucide="chevron-down" class="chevron-icon"></i>
      </button>
      <div class="engine-dropdown" id="engineDropdown">
        <button class="engine-item active" type="button" data-engine="google" data-action="https://www.google.com/search?q=">
          <img src="https://a.favicon.im/google.com" class="item-icon" alt="" />
          <span>Google</span>
        </button>
        <button class="engine-item" type="button" data-engine="baidu" data-action="https://www.baidu.com/s?wd=">
          <img src="https://a.favicon.im/baidu.com" class="item-icon" alt="" />
          <span>百度</span>
        </button>
        <button class="engine-item" type="button" data-engine="bing" data-action="https://cn.bing.com/search?q=">
          <img src="https://a.favicon.im/bing.com" class="item-icon" alt="" />
          <span>必应</span>
        </button>
        <button class="engine-item" type="button" data-engine="github" data-action="https://github.com/search?q=">
          <img src="https://a.favicon.im/github.com" class="item-icon" alt="" />
          <span>GitHub</span>
        </button>
      </div>
    </div>

    <!-- 分割线 -->
    <div class="divider"></div>

    <!-- 输入框 -->
    <input
      type="text"
      id="searchInput"
      placeholder="在 Google 中搜索..."
      autocomplete="off"
    />

    <!-- 键盘提示 -->
    <div class="kbd-hint" id="kbdHint">/</div>

    <!-- 清空按钮 -->
    <button class="clear-btn" id="clearBtn" type="button" style="display: none;">
      <i data-lucide="x" class="clear-icon"></i>
    </button>
  </div>

  <div class="quick-link-hint" id="quickLinkHint" hidden>
    <div class="quick-link-hint-body">
      <div class="quick-link-hint-icon">
        <i data-lucide="link-2"></i>
      </div>
      <div class="quick-link-hint-copy">
        <p class="quick-link-hint-title">检测到网址粘贴</p>
        <p class="quick-link-hint-text" id="quickLinkHintText">可直接打开添加卡片弹窗，并自动帮你带上网址。</p>
      </div>
    </div>
    <div class="quick-link-hint-actions">
      <button class="quick-link-hint-btn primary" id="quickLinkAddBtn" type="button">添加卡片</button>
      <button class="quick-link-hint-btn" id="quickLinkDismissBtn" type="button">继续搜索</button>
    </div>
  </div>
</div>

<style is:global>
  .search-container {
    width: 100%;
    max-width: 650px;
    margin: 0 auto;
    position: relative;
  }

  .search-wrapper {
    display: flex;
    align-items: center;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 7px 16px 7px 8px;
    box-shadow: var(--card-shadow);
    transition: var(--transition-smooth);
    position: relative;
    backdrop-filter: blur(10px);
    z-index: 99; /* 提升层级，防止下拉菜单被后方的网址卡片或分类区块遮挡 */
    
    /* 开启 GPU 硬件加速，防止聚焦或过渡时内部文本与图标产生亚像素抖动 */
    transform: translate3d(0, 0, 0);
    will-change: box-shadow, border-color, background-color;
    backface-visibility: hidden;
  }

  .search-wrapper:focus-within {
    border-color: var(--theme-primary-hover);
    box-shadow: 0 12px 40px -15px rgba(0, 0, 0, 0.05), 0 0 0 3px rgba(163, 179, 182, 0.18);
    background: var(--card-bg-hover);
  }

  .engine-selector {
    position: relative;
  }

  .current-engine-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    padding: 8px 14px;
    border-radius: 10px;
    cursor: pointer;
    color: var(--color-text-main);
    font-size: 13.5px;
    font-weight: 550;
    transition: var(--transition-smooth);
    
    /* 硬件加速稳定器 */
    transform: translate3d(0, 0, 0);
    will-change: background-color;
    backface-visibility: hidden;
  }

  .current-engine-btn:hover {
    background: rgba(0, 0, 0, 0.03);
  }

  .engine-icon {
    width: 15px;
    height: 15px;
    color: var(--theme-primary);
    
    /* 硬件加速以避免微小的图标抖动 */
    transform: translate3d(0, 0, 0);
    will-change: transform;
    backface-visibility: hidden;
  }

  .chevron-icon {
    width: 13px;
    height: 13px;
    opacity: 0.5;
    transition: var(--transition-smooth);
    
    /* 硬件加速以在旋转时消除颤抖 */
    transform: translate3d(0, 0, 0);
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  .current-engine-btn:hover .chevron-icon {
    opacity: 0.8;
    transform: translateY(1px);
  }

  .quick-link-hint {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 16px;
    border-radius: calc(var(--radius-md) + 2px);
    border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, var(--card-border));
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(248, 245, 241, 0.94));
    box-shadow: 0 12px 28px -20px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(16px);
    animation: fadeInUp 0.28s ease;
  }

  .quick-link-hint[hidden] {
    display: none;
  }

  .quick-link-hint-body {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .quick-link-hint-icon {
    width: 36px;
    height: 36px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--theme-primary);
    background: color-mix(in srgb, var(--theme-primary) 12%, white);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--theme-primary) 18%, transparent);
    flex-shrink: 0;
  }

  .quick-link-hint-icon i {
    width: 16px;
    height: 16px;
  }

  .quick-link-hint-copy {
    min-width: 0;
  }

  .quick-link-hint-title,
  .quick-link-hint-text {
    margin: 0;
  }

  .quick-link-hint-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-main);
    letter-spacing: 0.2px;
  }

  .quick-link-hint-text {
    margin-top: 3px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-text-sub);
  }

  .quick-link-hint-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .quick-link-hint-btn {
    border: none;
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-main);
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(0, 0, 0, 0.06);
    cursor: pointer;
    transition: var(--transition-smooth);
    white-space: nowrap;
  }

  .quick-link-hint-btn:hover {
    transform: translate3d(0, -1px, 0);
    background: rgba(255, 255, 255, 0.96);
  }

  .quick-link-hint-btn.primary {
    color: #fff;
    background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary-hover));
    border-color: transparent;
    box-shadow: 0 10px 20px -14px color-mix(in srgb, var(--theme-primary) 60%, black);
  }

  .quick-link-hint-btn.primary:hover {
    filter: saturate(1.06) brightness(1.02);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translate3d(0, 8px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  .divider {
    width: 1px;
    height: 22px;
    background: rgba(0, 0, 0, 0.06);
    margin: 0 6px;
  }

  input {
    flex-grow: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 14px;
    color: var(--color-text-main);
    padding: 8px 6px;
    font-family: inherit;
  }

  input::placeholder {
    color: var(--color-text-sub);
    opacity: 0.65;
  }

  .kbd-hint {
    font-size: 10px;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.05);
    color: var(--color-text-sub);
    padding: 3px 7px;
    border-radius: 6px;
    pointer-events: none;
    font-family: monospace;
    font-weight: bold;
    transition: var(--transition-smooth);
  }

  .search-wrapper:focus-within .kbd-hint {
    opacity: 0;
    transform: scale(0.8) translateY(-2px);
  }

  .clear-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-sub);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    border-radius: 50%;
    transition: var(--transition-smooth);
  }

  .clear-btn:hover {
    background: rgba(0, 0, 0, 0.05);
    color: var(--color-text-main);
  }

  .clear-icon {
    width: 14px;
    height: 14px;
  }

  /* 下拉菜单 */
  .engine-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    background: rgba(255, 255, 255, 0.98); /* 使用高密度背景遮挡后方卡片内容，解决文字穿透 */
    backdrop-filter: blur(20px);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.1), 0 5px 15px rgba(0, 0, 0, 0.03);
    padding: 5px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    z-index: 100;
    min-width: 130px;
    opacity: 0;
    transform: translate3d(0, -4px, 0); /* 仅使用极小垂直位移，完全舍弃 scale 缩放以根除缩放重绘抖动 */
    pointer-events: none;
    transition: var(--transition-smooth);
    
    /* 硬件加速层隔离 */
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  .engine-dropdown.open {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }

  .engine-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 12px;
    background: transparent;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
    font-size: 13px;
    color: var(--color-text-main);
    transition: var(--transition-smooth);

    /* 强制建立 GPU 硬件合成上下文，保障渲染纯净稳定 */
    transform: translate3d(0, 0, 0);
    will-change: background-color;
    backface-visibility: hidden;
  }

  .engine-item:hover {
    background: rgba(0, 0, 0, 0.045); /* 改用温润明晰的微深背景色，以配合当前不透明的下拉底色 */
  }

  .engine-item.active {
    background: rgba(154, 168, 173, 0.15);
    color: var(--theme-primary);
    font-weight: 600;
  }

  .item-icon {
    width: 14px;
    height: 14px;
    object-fit: contain;
    border-radius: 2px;

    /* 硬件加速稳定器 */
    transform: translate3d(0, 0, 0);
    will-change: transform;
    backface-visibility: hidden;
  }

  /* 当前搜索引擎原生 Favicon 图标样式 */
  .engine-icon-img {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    object-fit: contain;
    /* 硬件加速稳定器 */
    transform: translate3d(0, 0, 0);
    will-change: transform;
    backface-visibility: hidden;
  }
</style>

<script>
  import {
    getQuickAddHostLabel,
    normalizeUrlCandidate,
    saveQuickAddDraft,
    fetchUrlMetadata
  } from '../scripts/utils/link-quick-add';

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.search-container')) return;

    const engineBtn = document.getElementById('engineBtn');
    const engineDropdown = document.getElementById('engineDropdown');
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const currentEngineName = document.getElementById('currentEngineName');
    const clearBtn = document.getElementById('clearBtn') as HTMLElement;
    const kbdHint = document.getElementById('kbdHint') as HTMLElement;
    const quickLinkHint = document.getElementById('quickLinkHint') as HTMLElement;
    const quickLinkHintText = document.getElementById('quickLinkHintText') as HTMLElement;
    const quickLinkAddBtn = document.getElementById('quickLinkAddBtn') as HTMLButtonElement;
    const quickLinkDismissBtn = document.getElementById('quickLinkDismissBtn') as HTMLButtonElement;

    let activeEngine = 'google';
    let activeAction = 'https://www.google.com/search?q=';
    let pendingQuickLinkUrl = '';
    let pendingMetadata: { title?: string, description?: string } | null = null;

    const savedEngine = localStorage.getItem('nav_search_engine');
    if (savedEngine && savedEngine !== 'local') {
      const item = document.querySelector(`.engine-item[data-engine="${savedEngine}"]`);
      if (item) {
        selectEngine(item);
      }
    }

    function selectEngine(element: Element) {
      document.querySelectorAll('.engine-item').forEach(el => el.classList.remove('active'));
      element.classList.add('active');

      activeEngine = element.getAttribute('data-engine') || 'google';
      activeAction = element.getAttribute('data-action') || 'https://www.google.com/search?q=';
      const name = element.querySelector('span')?.textContent || '搜索';

      localStorage.setItem('nav_search_engine', activeEngine);

      currentEngineName!.textContent = name;

      const iconWrapper = document.getElementById('currentEngineIconWrapper');
      if (iconWrapper) {
        const domainMap: Record<string, string> = {
          google: 'google.com',
          baidu: 'baidu.com',
          bing: 'bing.com',
          github: 'github.com'
        };
        const domain = domainMap[activeEngine] || 'google.com';
        iconWrapper.innerHTML = `<img src="https://a.favicon.im/${domain}" class="engine-icon-img" alt="" />`;
      }

      if ((window as any).lucide) {
        (window as any).lucide.createIcons();
      }

      searchInput.placeholder = `在 ${name} 中搜索...`;
    }

    function hideQuickLinkHint() {
      pendingQuickLinkUrl = '';
      pendingMetadata = null;
      if (quickLinkHint) {
        quickLinkHint.hidden = true;
      }
    }

    async function showQuickLinkHint(url: string) {
      pendingQuickLinkUrl = url;
      pendingMetadata = null; // 重置
      const hostLabel = getQuickAddHostLabel(url);

      if (quickLinkHintText) {
        quickLinkHintText.textContent = `识别到 ${hostLabel} 链接，正在获取网页信息...`;
      }

      if (quickLinkHint) {
        quickLinkHint.hidden = false;
      }

      // 异步抓取元数据
      const metadata = await fetchUrlMetadata(url);
      
      // 如果在抓取期间用户已经清空或更改了 URL，则不处理
      if (pendingQuickLinkUrl !== url) return;

      pendingMetadata = metadata;
      
      if (quickLinkHintText) {
        if (metadata?.title) {
          quickLinkHintText.textContent = `已识别：${metadata.title}。点击“添加卡片”即可自动录入。`;
        } else {
          quickLinkHintText.textContent = `识别到 ${hostLabel} 链接，可直接打开添加卡片弹窗并自动填入网址。`;
        }
      }
    }

    engineBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      engineDropdown?.classList.toggle('open');
      const chevron = engineBtn.querySelector('.chevron-icon') as HTMLElement;
      if (chevron) {
        chevron.style.transform = engineDropdown?.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0)';
      }
    });

    document.querySelectorAll('.engine-item').forEach(item => {
      item.addEventListener('click', (e) => {
        e.stopPropagation();
        selectEngine(item);
        engineDropdown?.classList.remove('open');
        const chevron = engineBtn?.querySelector('.chevron-icon') as HTMLElement;
        if (chevron) chevron.style.transform = 'rotate(0)';
        searchInput.focus();
      });
    });

    document.addEventListener('click', () => {
      engineDropdown?.classList.remove('open');
      const chevron = engineBtn?.querySelector('.chevron-icon') as HTMLElement;
      if (chevron) chevron.style.transform = 'rotate(0)';
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput.focus();
      }
    });

    searchInput.addEventListener('input', () => {
      const rawValue = searchInput.value.trim();
      const val = rawValue.toLowerCase();

      if (val) {
        clearBtn.style.display = 'flex';
        kbdHint.style.display = 'none';
      } else {
        clearBtn.style.display = 'none';
        kbdHint.style.display = 'block';
      }

      if (!rawValue) {
        hideQuickLinkHint();
        return;
      }

      if (pendingQuickLinkUrl) {
        const normalizedCurrentUrl = normalizeUrlCandidate(rawValue);
        if (normalizedCurrentUrl !== pendingQuickLinkUrl) {
          hideQuickLinkHint();
        }
      }
    });

    searchInput.addEventListener('paste', (e) => {
      const rawText = e.clipboardData?.getData('text') || '';
      const normalizedUrl = normalizeUrlCandidate(rawText);
      if (!normalizedUrl) {
        hideQuickLinkHint();
        return;
      }

      window.setTimeout(() => {
        const currentUrl = normalizeUrlCandidate(searchInput.value);
        if (currentUrl === normalizedUrl) {
          showQuickLinkHint(normalizedUrl);
        }
      }, 0);
    });

    quickLinkAddBtn?.addEventListener('click', () => {
      if (!pendingQuickLinkUrl) return;
      saveQuickAddDraft({
        url: pendingQuickLinkUrl,
        title: pendingMetadata?.title,
        description: pendingMetadata?.description,
        source: 'search-paste'
      });
      window.location.href = '/admin';
    });

    quickLinkDismissBtn?.addEventListener('click', () => {
      hideQuickLinkHint();
      searchInput.focus();
    });

    clearBtn?.addEventListener('click', () => {
      searchInput.value = '';
      searchInput.dispatchEvent(new Event('input'));
      searchInput.focus();
    });

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const query = searchInput.value.trim();
        if (!query) return;

        window.open(`${activeAction}${encodeURIComponent(query)}`, '_blank');
      }
    });
  });
</script>
