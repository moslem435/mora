---
import { inject } from '@vercel/analytics';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Mora - 个人导航",
	description = "Mora - 极简优雅的莫兰迪低饱和度个人导航",
} = Astro.props;

inject();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<ClientRouter />
		<!-- 现代中文双语 Web 字体引入 (使用国内镜像加速与分包加载) -->
		<link href="https://fonts.loli.net/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		
		<!-- 引入 Lucide Icons CDN (锁定 v0.x 以保证 github/chrome 等品牌图标正常显示) -->
		<script src="https://unpkg.com/lucide@0.474.0" defer></script>
		<script is:inline>
			(function() {
				if (window.lucide && window.lucide.createIcons) {
					const originalCreateIcons = window.lucide.createIcons;
					window.lucide.createIcons = function(options) {
						options = options || {};
						options.icons = options.icons || window.lucide.icons;
						return originalCreateIcons.call(this, options);
					};
				}
			})();
		</script>

		<!-- 全局 Favicon 本地缓存与容灾加载机制 -->
		<script is:inline>
			(function() {
				const CACHE_KEY = "mora_favicons_cache";
				window.getFaviconFromCache = function(domain) {
					try {
						const cache = JSON.parse(localStorage.getItem(CACHE_KEY) || "{}");
						const val = cache[domain];
						if (val && val.indexOf("google.com") !== -1) {
							delete cache[domain];
							localStorage.setItem(CACHE_KEY, JSON.stringify(cache));
							return null;
						}
						return val || null;
					} catch (e) {
						return null;
					}
				};
				window.setFaviconToCache = function(domain, value) {
					try {
						const cache = JSON.parse(localStorage.getItem(CACHE_KEY) || "{}");
						cache[domain] = value;
						localStorage.setItem(CACHE_KEY, JSON.stringify(cache));
					} catch (e) {}
				};
				window.handleFaviconSuccess = function(img, domain) {
					img.style.display = 'block';
					if (img.nextElementSibling) {
						img.nextElementSibling.style.display = 'none';
					}
					if (domain) {
						window.setFaviconToCache(domain, img.src);
					}
					const card = img.closest('.link-card') || img.closest('.admin-link-card');
					if (card) {
						const wm = card.querySelector('.watermark-favicon');
						if (wm) {
							wm.src = img.src;
							wm.style.display = 'block';
							if (wm.nextElementSibling) {
								wm.nextElementSibling.style.display = 'none';
							}
						}
					}
				};
				window.handleFaviconError = function(img, domain) {
					if (!domain) {
						img.style.display = 'none';
						if (img.nextElementSibling) img.nextElementSibling.style.display = 'block';
						return;
					}
					const sources = [
						"https://api.iowen.cn/favicon/" + domain + ".png",
						"https://favicon.t.jiandao.info/" + domain,
						"https://icon.horse/icon/" + domain,
						"https://icons.duckduckgo.com/ip3/" + domain + ".ico",
						"https://unavatar.io/" + domain
					];
					let idx = parseInt(img.getAttribute('data-fav-idx') || '0');
					if (idx < sources.length) {
						img.setAttribute('data-fav-idx', String(idx + 1));
						img.src = sources[idx];
					} else {
						img.style.display = 'none';
						if (img.nextElementSibling) {
							img.nextElementSibling.style.display = 'block';
						}
						// 容灾失败，存入失败记录，防止后续重复尝试
						window.setFaviconToCache(domain, 'failed');
					}
				};
			})();
		</script>

		<!-- 首屏极速防闪烁与透明度/模糊度同步脚本 -->
		<script is:inline>
			(function () {
				try {
					const data = localStorage.getItem("nav_appearance");
					if (!data) return;
					const config = JSON.parse(data);
					const doc = document.documentElement;

					// 1. 同步卡片不透明度和毛玻璃模糊度 CSS 变量
					const opacity =
						config.cardOpacity !== undefined
							? config.cardOpacity
							: 0.65;
					const blur =
						config.cardBlur !== undefined ? config.cardBlur : 20;
					const primaryColor = config.primaryColor || "blue";

					doc.style.setProperty("--card-bg-opacity", String(opacity));
					doc.style.setProperty("--card-blur-radius", blur + "px");

					if (config.bgStyle === "dark-slate") {
						doc.style.setProperty(
							"--card-bg",
							"rgba(38, 41, 43, " + opacity + ")",
						);
						doc.style.setProperty("--color-bg", "#1e2122");
						doc.style.setProperty("--color-text-main", "#e8e8e8");
						doc.style.setProperty("--color-text-sub", "#9ba1a3");
					} else {
						doc.style.setProperty(
							"--card-bg",
							"rgba(255, 255, 255, " + opacity + ")",
						);
					}

					doc.style.setProperty(
						"--theme-primary",
						"var(--theme-" + primaryColor + ")",
					);
					doc.style.setProperty(
						"--theme-primary-rgb",
						"var(--theme-" + primaryColor + "-rgb)",
					);
					doc.style.setProperty(
						"--theme-primary-hover",
						"var(--theme-" +
							primaryColor +
							"-hover, var(--theme-" +
							primaryColor +
							"))",
					);

					// 2. 同步自定义在线与本地壁纸 URL 变量
					if (config.bgStyle === "custom-url" && config.customBgUrl) {
						doc.style.setProperty(
							"--custom-bg-image-url",
							'url("' + config.customBgUrl + '")',
						);
					} else if (config.bgStyle === "custom-file") {
						const cachedBg = sessionStorage.getItem("mora_temp_bg_url");
						if (cachedBg) {
							doc.style.setProperty(
								"--custom-bg-image-url",
								'url("' + cachedBg + '")',
							);
						}
					}

					// 2.5 同步自定义字体文件与链接变量
					if (config.fontStyle === "custom-file") {
						const cachedFontUrl = sessionStorage.getItem("mora_temp_font_url");
						const cachedFontName = sessionStorage.getItem("mora_temp_font_name") || "LocalCustomFont";
						if (cachedFontUrl) {
							doc.style.setProperty("--font-family-custom", cachedFontName);
							let styleEl = document.getElementById("custom-fonts-style");
							if (!styleEl) {
								styleEl = document.createElement("style");
								styleEl.id = "custom-fonts-style";
								document.head.appendChild(styleEl);
							}
							styleEl.innerHTML = '@font-face { font-family: "' + cachedFontName + '"; src: url("' + cachedFontUrl + '"); font-display: block; }';
						}
					} else if (config.fontStyle === "custom-link" && config.fontCustomLink) {
						const familyName = config.fontFamilyName || "OnlineCustomFont";
						doc.style.setProperty("--font-family-custom", familyName);
						if (config.fontCustomLink.indexOf(".css") !== -1 || config.fontCustomLink.indexOf("fonts.googleapis.com") !== -1) {
							let linkEl = document.getElementById("online-font-link");
							if (!linkEl) {
								linkEl = document.createElement("link");
								linkEl.id = "online-font-link";
								linkEl.rel = "stylesheet";
								document.head.appendChild(linkEl);
							}
							linkEl.href = config.fontCustomLink;
						} else {
							let styleEl = document.getElementById("custom-fonts-style");
							if (!styleEl) {
								styleEl = document.createElement("style");
								styleEl.id = "custom-fonts-style";
								document.head.appendChild(styleEl);
							}
							styleEl.innerHTML = '@font-face { font-family: "' + familyName + '"; src: url("' + config.fontCustomLink + '"); font-display: block; }';
						}
					}

					// 3. 将字体和背景的 Class 同步渲染在 html 根节点，实现首屏绘制对齐
					doc.classList.add('font-' + (config.fontStyle || 'morandi-sans'));
					doc.classList.add('bg-' + (config.bgStyle || 'morandi-glow'));

					// 4. 同步是否显示滚动条的 Class
					if (config.scrollbarEnabled) {
						doc.classList.add("scrollbar-enabled");
					} else {
						doc.classList.remove("scrollbar-enabled");
					}
				} catch (e) {
					console.error("Appearance fast-init failed:", e);
				}
			})();
		</script>
	</head>
	<body>
		<div class="app-container">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	/* 莫兰迪配色系统及全局变量 */
	:root {
		/* 全局默认字体变量，作为第一层兜底 */
		--font-global: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;

		/* 基础背景与文字 */
		--color-bg: #f5f4f0; /* 静谧暖米灰 */
		--color-text-main: #222222; /* 调深为主炭黑，极大增加字迹清晰度 */
		--color-text-sub: #585858; /* 调深为中深灰，提升小字阅读对比度 */

		/* 极现代玻璃拟态卡片配置 */
		--card-bg: rgba(255, 255, 255, 0.65);
		--card-bg-hover: rgba(255, 255, 255, 0.88);
		--card-border: rgba(226, 222, 211, 0.5);
		--card-border-hover: rgba(163, 179, 182, 0.5);
		--card-shadow: 0 10px 30px -10px rgba(67, 67, 67, 0.04);
		--card-shadow-hover:
			0 20px 40px -15px rgba(67, 67, 67, 0.08),
			0 0 0 1px rgba(163, 179, 182, 0.1);

		/* 莫兰迪分类色彩组合（低饱和度，温润沉静） */
		--theme-blue: #9aa8ad; /* 烟雨蓝 */
		--theme-blue-rgb: 154, 168, 173;
		--theme-green: #a0b0a3; /* 烟草绿 */
		--theme-green-rgb: 160, 176, 163;
		--theme-purple: #b5abb0; /* 丁香灰 */
		--theme-purple-rgb: 181, 171, 176;
		--theme-pink: #ccbab0; /* 珊瑚粉 */
		--theme-pink-rgb: 204, 186, 176;
		--theme-orange: #d1c1b3; /* 燕麦杏 */
		--theme-orange-rgb: 209, 193, 179;
		--theme-yellow: #cab99b; /* 芥末黄 */
		--theme-yellow-rgb: 202, 185, 155;

		/* 默认莫兰迪主题色（用于主按钮/高亮） */
		--theme-primary: var(--theme-blue);
		--theme-primary-rgb: var(--theme-blue-rgb);
		--theme-primary-hover: #8ea0a4;

		/* 圆角和过渡时间 */
		--radius-sm: 8px;
		--radius-md: 16px;
		--radius-lg: 28px;
		--transition-smooth: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
		--transition-elastic: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.15);
		/* 更窄的过渡 token：仅动画 transform/颜色/阴影，避免 transition: all 触发布局抖动 */
		--transition-ui: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1),
			box-shadow 0.35s cubic-bezier(0.25, 1, 0.5, 1),
			background-color 0.35s cubic-bezier(0.25, 1, 0.5, 1),
			border-color 0.35s cubic-bezier(0.25, 1, 0.5, 1),
			color 0.35s cubic-bezier(0.25, 1, 0.5, 1),
			opacity 0.35s cubic-bezier(0.25, 1, 0.5, 1);
	}

	/* 全局重置与基础样式 */
	::selection {
		background-color: color-mix(in srgb, var(--theme-primary) 35%, transparent);
		color: inherit;
	}

	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	/* 强制全站及表单控件使用全局字体变量，避免继承链断层 */
	html, body, input, button, select, textarea {
		font-family: var(--font-global);
	}

	html {
		background-color: var(--color-bg);
		color: var(--color-text-main);
		scroll-behavior: smooth;
		overflow-x: hidden;

		/* 全局启用文本抗锯齿及 ClearType 渲染优化 */
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		text-rendering: optimizeLegibility;
	}

	/* 第一版：思源莫兰迪黑体 (其他已废弃的字体选项做平滑兼容回退) */
	html.font-morandi-sans,
	html.font-inter,
	html.font-outfit,
	html.font-geist,
	html.font-lxgw-wenkai,
	html.font-geist-sans,
	html.font-cormorant-serif {
		--font-global: 'Plus Jakarta Sans', 'Noto Sans SC', system-ui, -apple-system, sans-serif;
	}

	/* 第二版：本地微软雅黑高清 */
	html.font-system-sans {
		--font-global: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
	}

	/* 第三版：自定义在线字体或本地上传字体 */
	html.font-custom-link, html.font-custom-file {
		--font-global: var(--font-family-custom), -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif !important;
	}

	body {
		min-height: 100vh;
		position: relative;
		background-attachment: fixed;
		background-color: var(--color-bg);
		transition:
			background-color 0.4s ease,
			background-image 0.4s ease;
	}

	/* ================= 4 种背景美化风格定义 ================= */

	/* 1. 莫兰迪流光渐变（默认） */
	html.bg-morandi-glow body,
	body.bg-morandi-glow {
		background-image:
			radial-gradient(
				circle at 5% 10%,
				rgba(154, 168, 173, 0.15) 0%,
				transparent 35%
			),
			radial-gradient(
				circle at 95% 85%,
				rgba(204, 186, 176, 0.15) 0%,
				transparent 40%
			),
			linear-gradient(to bottom, #f5f4f0, #f0eee8);
	}

	/* 2. 暖米纯色 */
	html.bg-solid-cream body,
	body.bg-solid-cream {
		background-color: #f5f4f0;
		background-image: none;
	}

	/* 3. 静谧深空暗调 */
	html.bg-dark-slate body,
	body.bg-dark-slate {
		background-color: #1e2122;
		background-image: none;
		--color-bg: #1e2122;
		--color-text-main: #e8e8e8;
		--color-text-sub: #9ba1a3;
		--card-bg: rgba(38, 41, 43, var(--card-bg-opacity, 0.65)) !important;
		--card-border: rgba(255, 255, 255, 0.06);
		--card-border-hover: rgba(255, 255, 255, 0.15);
		--card-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.2);
		--card-shadow-hover:
			0 20px 40px -15px rgba(0, 0, 0, 0.35),
			0 0 0 1px rgba(255, 255, 255, 0.05);
	}
	html.bg-dark-slate a.back-home-btn,
	html.bg-dark-slate .action-btn.secondary,
	html.bg-dark-slate .cat-icon-box,
	html.bg-dark-slate .tab-btn,
	html.bg-dark-slate .custom-select-trigger,
	html.bg-dark-slate .admin-form input,
	html.bg-dark-slate .admin-form select,
	html.bg-dark-slate .icon-btn,
	body.bg-dark-slate a.back-home-btn,
	body.bg-dark-slate .action-btn.secondary,
	body.bg-dark-slate .cat-icon-box,
	body.bg-dark-slate .tab-btn,
	body.bg-dark-slate .custom-select-trigger,
	body.bg-dark-slate .admin-form input,
	body.bg-dark-slate .admin-form select,
	body.bg-dark-slate .icon-btn {
		background: rgba(255, 255, 255, 0.04) !important;
		color: #e8e8e8 !important;
		border-color: rgba(255, 255, 255, 0.08) !important;
	}
	html.bg-dark-slate .tab-btn.active,
	body.bg-dark-slate .tab-btn.active {
		background: var(--theme-primary) !important;
		color: #fff !important;
		border-color: var(--theme-primary) !important;
	}
	html.bg-dark-slate .custom-options-container,
	body.bg-dark-slate .custom-options-container {
		background: rgba(30, 33, 34, 0.95) !important;
		border-color: rgba(255, 255, 255, 0.08) !important;
	}
	html.bg-dark-slate .custom-option:hover,
	body.bg-dark-slate .custom-option:hover {
		background: rgba(255, 255, 255, 0.06) !important;
	}

	/* 4. 自定义壁纸风格 */
	html.bg-custom-url, html.bg-custom-file {
		background-color: var(--color-bg);
		background-image: var(--custom-bg-image-url, none);
		--color-text-main: #111111;
		--color-text-sub: #4b4b4b;
	}

	html.bg-custom-url body, html.bg-custom-file body,
	body.bg-custom-url, body.bg-custom-file {
		background-color: transparent;
		background-image: var(--custom-bg-image-url, none);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		background-attachment: fixed;
	}

	html.bg-custom-url::-webkit-scrollbar-track,
	html.bg-custom-file::-webkit-scrollbar-track {
		background: transparent;
	}

	html.bg-custom-url::after, html.bg-custom-file::after,
	body.bg-custom-url::after, body.bg-custom-file::after {
		content: "";
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(245, 244, 240, 0.45);
		z-index: -2;
		pointer-events: none;
	}

	/* 定义美化设置中所选背景模式的伪莫兰迪圆点颜色 */
	:root {
		--theme-morandi-glow: #9aa8ad;
		--theme-solid-cream: #ccbab0;
		--theme-dark-slate: #3a3a3a;
		--theme-custom-url: #cab99b;
		--theme-custom-file: #b5abb0;
		--theme-custom-link: #9aa8ad;
	}

	/* ================= 静谧深空暗调模式下的局部组件深度适配 ================= */

	/* 1. 侧边栏及内部挂件 */
	html.bg-dark-slate .sidebar-container {
		background: rgba(30, 33, 34, 0.72) !important;
		border-right-color: rgba(255, 255, 255, 0.06) !important;
		box-shadow: 10px 0 40px -20px rgba(0, 0, 0, 0.5) !important;
	}

	html.bg-dark-slate .time-widget,
	html.bg-dark-slate .weather-widget {
		background: rgba(255, 255, 255, 0.06) !important;
		border-color: rgba(255, 255, 255, 0.08) !important;
		box-shadow: 0 6px 20px -10px rgba(0, 0, 0, 0.4) !important;
	}

	html.bg-dark-slate .weather-widget:hover {
		background: rgba(255, 255, 255, 0.06) !important;
	}

	html.bg-dark-slate .nav-item {
		color: #e8e8e8 !important;
	}

	html.bg-dark-slate .nav-item:hover {
		background: rgba(255, 255, 255, 0.05) !important;
		border-color: rgba(255, 255, 255, 0.08) !important;
	}

	html.bg-dark-slate .nav-item.active {
		background: rgba(255, 255, 255, 0.08) !important;
		color: var(--theme-primary) !important;
		border-color: rgba(255, 255, 255, 0.1) !important;
	}

	/* 2. 搜索引擎下拉菜单及项 */
	html.bg-dark-slate .engine-dropdown {
		background: rgba(30, 33, 34, 0.98) !important;
		border-color: rgba(255, 255, 255, 0.08) !important;
		box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.4) !important;
	}

	html.bg-dark-slate .engine-item {
		color: #e8e8e8 !important;
	}

	html.bg-dark-slate .engine-item:hover {
		background: rgba(255, 255, 255, 0.06) !important;
	}

	html.bg-dark-slate .engine-item.active {
		background: rgba(255, 255, 255, 0.08) !important;
		color: var(--theme-primary) !important;
	}

	html.bg-dark-slate .current-engine-btn:hover {
		background: rgba(255, 255, 255, 0.04) !important;
	}

	/* 3. 搜索键盘提示与分割线 */
	html.bg-dark-slate .kbd-hint {
		background: rgba(255, 255, 255, 0.06) !important;
		border-color: rgba(255, 255, 255, 0.08) !important;
		color: #9ba1a3 !important;
	}

	html.bg-dark-slate .search-wrapper .divider {
		background: rgba(255, 255, 255, 0.08) !important;
	}

	html.bg-dark-slate .clear-btn:hover {
		background: rgba(255, 255, 255, 0.06) !important;
		color: #e8e8e8 !important;
	}

	/* 4. 管理后台模态弹窗 */
	html.bg-dark-slate .modal-box {
		background: rgba(38, 41, 43, 0.95) !important;
		border-color: rgba(255, 255, 255, 0.08) !important;
		color: #e8e8e8 !important;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4) !important;
	}

	html.bg-dark-slate .modal-box h3 {
		color: #e8e8e8 !important;
	}

	html.bg-dark-slate .modal-btn.secondary {
