<!-- 客户端首屏无感渲染个性化美化层 -->
<script>
	import { storage, dbStorage } from "../scripts/storage";

	let activeBgObjectURL = "";
	let activeFontObjectURL = "";

	async function applyAppearance() {
		const config = storage.getAppearance();
		const doc = document.documentElement;
		const body = document.body;
		if (!body) return;

		console.log('[Layout] applyAppearance executed. Configured fontStyle:', config.fontStyle, 'HTML Classes:', doc.className);

		// 1. 动态应用卡片不透明度和模糊度 CSS 自定义变量
		doc.style.setProperty("--card-bg-opacity", String(config.cardOpacity));
		doc.style.setProperty("--card-blur-radius", `${config.cardBlur}px`);

		if (config.bgStyle === "dark-slate") {
			doc.style.setProperty(
				"--card-bg",
				`rgba(38, 41, 43, ${config.cardOpacity})`,
			);
			doc.style.setProperty("--color-bg", "#1e2122");
			doc.style.setProperty("--color-text-main", "#e8e8e8");
			doc.style.setProperty("--color-text-sub", "#9ba1a3");
		} else {
			doc.style.setProperty(
				"--card-bg",
				`rgba(255, 255, 255, ${config.cardOpacity})`,
			);
			doc.style.removeProperty("--color-bg");
			doc.style.removeProperty("--color-text-main");
			doc.style.removeProperty("--color-text-sub");
		}

		// 2. 动态应用莫兰迪高亮主题主色
		doc.style.setProperty(
			"--theme-primary",
			`var(--theme-${config.primaryColor})`,
		);
		doc.style.setProperty(
			"--theme-primary-rgb",
			`var(--theme-${config.primaryColor}-rgb)`,
		);
		doc.style.setProperty(
			"--theme-primary-hover",
			`var(--theme-${config.primaryColor}-hover, var(--theme-${config.primaryColor}))`,
		);

		// 3. 动态应用背景风格及壁纸图片
		doc.classList.remove(
			"bg-morandi-glow",
			"bg-solid-cream",
			"bg-dark-slate",
			"bg-custom-url",
			"bg-custom-file",
		);
		doc.classList.add(`bg-${config.bgStyle}`);
		body.classList.remove(
			"bg-morandi-glow",
			"bg-solid-cream",
			"bg-dark-slate",
			"bg-custom-url",
			"bg-custom-file",
		);
		body.classList.add(`bg-${config.bgStyle}`);

		// 清理旧的内存壁纸引用
		const sessionBgUrl = sessionStorage.getItem("mora_temp_bg_url");
		if (activeBgObjectURL && activeBgObjectURL !== sessionBgUrl) {
			URL.revokeObjectURL(activeBgObjectURL);
			activeBgObjectURL = "";
		}

		if (config.bgStyle === "custom-url" && config.customBgUrl) {
			const urlVal = `url("${config.customBgUrl}")`;
			doc.style.setProperty("--custom-bg-image-url", urlVal);
			body.style.backgroundImage = urlVal;
		} else if (config.bgStyle === "custom-file") {
			try {
				const blob = await dbStorage.getAsset("custom-bg-file");
				if (blob) {
					if (!sessionBgUrl) {
						activeBgObjectURL = URL.createObjectURL(blob);
						sessionStorage.setItem("mora_temp_bg_url", activeBgObjectURL);
					} else {
						activeBgObjectURL = sessionBgUrl;
					}
					const urlVal = `url("${activeBgObjectURL}")`;
					doc.style.setProperty("--custom-bg-image-url", urlVal);
					body.style.backgroundImage = urlVal;
				} else {
					// 降级保护
					doc.classList.remove("bg-custom-file");
					doc.classList.add("bg-morandi-glow");
					body.classList.remove("bg-custom-file");
					body.classList.add("bg-morandi-glow");
					body.style.backgroundImage = "";
					doc.style.removeProperty("--custom-bg-image-url");
					sessionStorage.removeItem("mora_temp_bg_url");
				}
			} catch (e) {
				console.error(
					"Failed to load local background image from IndexedDB:",
					e,
				);
				body.style.backgroundImage = "";
				doc.style.removeProperty("--custom-bg-image-url");
				sessionStorage.removeItem("mora_temp_bg_url");
			}
		} else {
			body.style.backgroundImage = "";
			doc.style.removeProperty("--custom-bg-image-url");
			sessionStorage.removeItem("mora_temp_bg_url");
		}

		// 4. 动态应用全局字体风格与动态注册
		doc.classList.remove('font-morandi-sans', 'font-system-sans', 'font-inter', 'font-outfit', 'font-geist', 'font-custom-link', 'font-custom-file', 'font-lxgw-wenkai', 'font-geist-sans', 'font-cormorant-serif');
		doc.classList.add(`font-${config.fontStyle || 'morandi-sans'}`);

		// 获取/创建样式注入容器
		let customStyleTag = document.getElementById("custom-fonts-style");
		if (customStyleTag) {
			customStyleTag.innerHTML = "";
		} else {
			customStyleTag = document.createElement("style");
			customStyleTag.id = "custom-fonts-style";
			document.head.appendChild(customStyleTag);
		}

		if (config.fontStyle === "custom-link" && config.fontCustomLink) {
			const linkUrl = config.fontCustomLink.trim();
			const familyName =
				config.fontFamilyName?.trim() || "OnlineCustomFont";

			doc.style.setProperty("--font-family-custom", familyName);

			if (
				linkUrl.includes(".css") ||
				linkUrl.includes("fonts.googleapis.com")
			) {
				let fontLink = document.getElementById(
					"online-font-link",
				) as HTMLLinkElement;
				if (!fontLink) {
					fontLink = document.createElement("link");
					fontLink.id = "online-font-link";
					fontLink.rel = "stylesheet";
					document.head.appendChild(fontLink);
				}
				fontLink.href = linkUrl;
			} else {
				customStyleTag.innerHTML = `
					@font-face {
						font-family: "${familyName}";
						src: url("${linkUrl}");
						font-display: block;
					}
				`;
				document.getElementById("online-font-link")?.remove();
			}
		} else if (config.fontStyle === "custom-file") {
			const familyName =
				config.fontFamilyName?.trim() || "LocalCustomFont";
			doc.style.setProperty("--font-family-custom", familyName);

			try {
				const blob = await dbStorage.getAsset("custom-font-file");
				if (blob) {
					const sessionFontUrl = sessionStorage.getItem("mora_temp_font_url");
					if (!sessionFontUrl) {
						if (activeFontObjectURL) {
							URL.revokeObjectURL(activeFontObjectURL);
						}
						activeFontObjectURL = URL.createObjectURL(blob);
						sessionStorage.setItem("mora_temp_font_url", activeFontObjectURL);
						sessionStorage.setItem("mora_temp_font_name", familyName);
					} else {
						activeFontObjectURL = sessionFontUrl;
					}
					customStyleTag.innerHTML = `
						@font-face {
							font-family: "${familyName}";
							src: url("${activeFontObjectURL}");
							font-display: block;
						}
					`;
				}
			} catch (e) {
				console.error(
					"Failed to load local font file from IndexedDB:",
					e,
				);
				sessionStorage.removeItem("mora_temp_font_url");
				sessionStorage.removeItem("mora_temp_font_name");
			}
		} else {
			document.getElementById("online-font-link")?.remove();
			sessionStorage.removeItem("mora_temp_font_url");
			sessionStorage.removeItem("mora_temp_font_name");
		}

		// 5. 动态应用滚动条开关 Class
		if (config.scrollbarEnabled) {
			doc.classList.add("scrollbar-enabled");
		} else {
			doc.classList.remove("scrollbar-enabled");
		}
	}

	// 首次加载和后续路由跳转时均触发无感是个性化应用渲染
	document.addEventListener("astro:page-load", applyAppearance);
	
	// 接收全局的个性化设定变更通知，即时响应渲染更新
	window.addEventListener("appearance-updated", applyAppearance);
</script>
